diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 0ed8d41..caf4baf 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -11,6 +11,34 @@ concurrency:
   cancel-in-progress: true
 
 jobs:
+  ########################### macOS / Cocoa ###########################
+  # The same sources against Apple's Foundation and libdispatch, where
+  # dispatch objects are Objective-C objects -- the other half of
+  # UD_DISPATCH_PROPERTY. macOS minutes bill at 10x on a private repository.
+  macos:
+    name: macOS
+    runs-on: macos-15
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Show toolchain
+        run: xcodebuild -version
+
+      # On its own, so a compile error is reported as that.
+      - name: Build
+        run: |
+          xcodebuild -workspace UDWorkflow.xcworkspace -scheme UDWorkflow \
+            -destination 'platform=macOS' -configuration Debug build
+          xcodebuild -workspace UDWorkflow.xcworkspace -scheme PurchaseRequestDemo \
+            -destination 'platform=macOS' -configuration Debug build
+
+      - name: Unit tests
+        run: |
+          xcodebuild -workspace UDWorkflow.xcworkspace -scheme UDWorkflow \
+            -destination 'platform=macOS' -configuration Debug \
+            -resultBundlePath "$RUNNER_TEMP/UDWorkflowTests.xcresult" test
+
   ########################### GNUstep / Linux ###########################
   # Built against the patched stack from gnustep-patches, by that
   # repository's own Scripts/build-gnustep.sh -- the shape ODataStore uses --
