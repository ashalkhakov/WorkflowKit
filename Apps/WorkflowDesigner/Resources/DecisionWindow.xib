<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="WKDDecisionWindowController">
            <connections>
                <outlet property="window" destination="WKDdw-window" id="WKDdw-o-window"/>
                <outlet property="split" destination="WKDdw-split" id="WKDdw-o-split"/>
                <outlet property="listHost" destination="WKDdw-listhost" id="WKDdw-o-listHost"/>
                <outlet property="detailHost" destination="WKDdw-detailhost" id="WKDdw-o-detailHost"/>
                <outlet property="tablePanel" destination="WKDdw-tablepanel" id="WKDdw-o-tablePanel"/>
                <outlet property="gridHost" destination="WKDdw-gridhost" id="WKDdw-o-gridHost"/>
                <outlet property="columnHost" destination="WKDdw-columnhost" id="WKDdw-o-columnHost"/>
                <outlet property="literalHost" destination="WKDdw-literalhost" id="WKDdw-o-literalHost"/>
                <outlet property="statusField" destination="WKDdw-status" id="WKDdw-o-statusField"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Decisions" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" visibleAtLaunch="NO" animationBehavior="default" id="WKDdw-window">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" rightStrut="YES" topStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="196" y="240" width="1040" height="620"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1920" height="1080"/>
            <value key="minSize" type="size" width="760" height="420"/>
            <view key="contentView" id="WKDdw-content">
                <rect key="frame" x="0.0" y="0.0" width="1040" height="620"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <splitView arrangesAllSubviews="NO" dividerStyle="thin" vertical="YES" id="WKDdw-split">
                        <rect key="frame" x="0.0" y="24" width="1040" height="596"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <customView id="WKDdw-listhost">
                                <rect key="frame" x="0.0" y="0.0" width="220" height="596"/>
                                <autoresizingMask key="autoresizingMask" heightSizable="YES"/>
                            </customView>
                            <customView id="WKDdw-right">
                                <rect key="frame" x="221" y="0.0" width="819" height="596"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <subviews>
                                    <customView id="WKDdw-detailhost">
                                        <rect key="frame" x="8" y="524" width="803" height="72"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                                    </customView>
                                    <customView id="WKDdw-tablepanel">
                                        <rect key="frame" x="8" y="4" width="803" height="516"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <subviews>
                                            <customView id="WKDdw-gridhost">
                                                <rect key="frame" x="0.0" y="64" width="803" height="452"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                            </customView>
                                            <customView id="WKDdw-columnhost">
                                                <rect key="frame" x="0.0" y="0.0" width="803" height="60"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                                            </customView>
                                        </subviews>
                                    </customView>
                                    <customView id="WKDdw-literalhost">
                                        <rect key="frame" x="8" y="4" width="803" height="516"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    </customView>
                                </subviews>
                            </customView>
                        </subviews>
                        <holdingPriorities>
                            <real value="250"/>
                            <real value="250"/>
                        </holdingPriorities>
                        <connections>
                            <outlet property="delegate" destination="-2" id="WKDdw-o-splitdelegate"/>
                        </connections>
                    </splitView>
                    <textField focusRingType="none" verticalHuggingPriority="750" id="WKDdw-status">
                        <rect key="frame" x="10" y="4" width="1020" height="16"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                        <textFieldCell key="cell" controlSize="small" lineBreakMode="truncatingTail" alignment="left" title="" id="WKDdw-statuscell">
                            <font key="font" metaFont="smallSystem"/>
                            <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                </subviews>
            </view>
            <connections>
                <outlet property="delegate" destination="-2" id="WKDdw-o-windowdelegate"/>
            </connections>
        </window>
    </objects>
</document>
