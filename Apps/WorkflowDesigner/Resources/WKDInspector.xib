<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="WKDInspectorViewController">
            <connections>
                <outlet property="view" destination="WKDin-scroll" id="WKDin-o-view"/>
                <outlet property="stack" destination="WKDin-stack" id="WKDin-o-stack"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <scrollView borderType="none" autohidesScrollers="NO" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO" id="WKDin-scroll">
            <rect key="frame" x="0.0" y="0.0" width="360" height="700"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <clipView key="contentView" id="WKDin-clip">
                <rect key="frame" x="0.0" y="0.0" width="345" height="700"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <customView id="WKDin-stack" customClass="WKDInspectorStack">
                        <rect key="frame" x="0.0" y="0.0" width="345" height="700"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                    </customView>
                </subviews>
            </clipView>
            <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="YES" id="WKDin-hs">
                <rect key="frame" x="-100" y="-100" width="345" height="15"/>
                <autoresizingMask key="autoresizingMask"/>
            </scroller>
            <scroller key="verticalScroller" verticalHuggingPriority="750" horizontal="NO" id="WKDin-vs">
                <rect key="frame" x="345" y="0.0" width="15" height="700"/>
                <autoresizingMask key="autoresizingMask" flexibleMinX="YES" heightSizable="YES"/>
            </scroller>
            <connections>
                <outlet property="documentView" destination="WKDin-stack" id="WKDin-o-doc"/>
            </connections>
        </scrollView>
    </objects>
</document>
