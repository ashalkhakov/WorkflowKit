<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="WKDColumnViewController">
            <connections>
                <outlet property="view" destination="WKDco-view" id="WKDco-o-view"/>
                <outlet property="titleLabel" destination="WKDco-title" id="WKDco-o-titleLabel"/>
                <outlet property="labelLabel" destination="WKDco-labellabel" id="WKDco-o-labelLabel"/>
                <outlet property="labelField" destination="WKDco-label" id="WKDco-o-labelField"/>
                <outlet property="expressionLabel" destination="WKDco-exprlabel" id="WKDco-o-expressionLabel"/>
                <outlet property="expressionField" destination="WKDco-expr" id="WKDco-o-expressionField"/>
                <outlet property="nameLabel" destination="WKDco-namelabel" id="WKDco-o-nameLabel"/>
                <outlet property="outputNameField" destination="WKDco-name" id="WKDco-o-outputNameField"/>
                <outlet property="typeLabel" destination="WKDco-typelabel" id="WKDco-o-typeLabel"/>
                <outlet property="typePopup" destination="WKDco-type" id="WKDco-o-typePopup"/>
                <outlet property="variableLabel" destination="WKDco-varlabel" id="WKDco-o-variableLabel"/>
                <outlet property="inputVariableField" destination="WKDco-var" id="WKDco-o-inputVariableField"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="WKDco-view">
            <rect key="frame" x="0.0" y="0.0" width="800" height="60"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
            <subviews>
                <textField focusRingType="none" verticalHuggingPriority="750" id="WKDco-title">
                    <rect key="frame" x="0.0" y="38" width="800" height="18"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="truncatingTail" alignment="left" title="Column" id="WKDco-title-cell">
                        <font key="font" metaFont="systemBold" size="12"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="WKDco-labellabel">
                    <rect key="frame" x="0.0" y="11" width="40" height="16"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="truncatingTail" alignment="right" title="Label" id="WKDco-labellabel-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="WKDco-label">
                    <rect key="frame" x="44" y="8" width="150" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="WKDco-label-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <action selector="columnLabelChanged:" target="-2" id="WKDco-label-action"/>
                    </connections>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="WKDco-exprlabel">
                    <rect key="frame" x="198" y="11" width="66" height="16"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="truncatingTail" alignment="right" title="Expression" id="WKDco-exprlabel-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <customView id="WKDco-expr" customClass="WKDExpressionField">
                    <rect key="frame" x="268" y="8" width="232" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                </customView>
                <textField focusRingType="none" verticalHuggingPriority="750" id="WKDco-namelabel">
                    <rect key="frame" x="198" y="11" width="66" height="16"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="truncatingTail" alignment="right" title="Name" id="WKDco-namelabel-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="WKDco-name">
                    <rect key="frame" x="268" y="8" width="232" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="WKDco-name-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <action selector="columnNameChanged:" target="-2" id="WKDco-name-action"/>
                    </connections>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="WKDco-typelabel">
                    <rect key="frame" x="508" y="11" width="34" height="16"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="truncatingTail" alignment="right" title="Type" id="WKDco-typelabel-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <popUpButton id="WKDco-type">
                    <rect key="frame" x="546" y="6" width="104" height="26"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" controlSize="small" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="WKDco-type-cell">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                        <menu key="menu" id="WKDco-type-menu"/>
                    </popUpButtonCell>
                    <connections>
                        <action selector="columnTypeChanged:" target="-2" id="WKDco-type-action"/>
                    </connections>
                </popUpButton>
                <textField focusRingType="none" verticalHuggingPriority="750" id="WKDco-varlabel">
                    <rect key="frame" x="652" y="11" width="52" height="16"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="truncatingTail" alignment="right" title="Variable" id="WKDco-varlabel-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="WKDco-var">
                    <rect key="frame" x="708" y="8" width="92" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" placeholderString="cellInput" drawsBackground="YES" id="WKDco-var-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <action selector="columnVariableChanged:" target="-2" id="WKDco-var-action"/>
                    </connections>
                </textField>
            </subviews>
        </customView>
    </objects>
</document>
