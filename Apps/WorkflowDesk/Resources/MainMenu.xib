<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSApplication">
            <connections>
                <outlet property="delegate" destination="WDm-de-001" id="WDm-ol-001"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customObject id="WDm-de-001" customClass="WDAppDelegate"/>
        <menu title="Main Menu" systemMenu="main" id="WDm-mm-001">
            <items>
                <menuItem title="WorkflowDesk" id="WDm-mt-013">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="WorkflowDesk" systemMenu="apple" id="WDm-mn-014">
                        <items>
                            <menuItem title="About WorkflowDesk" id="WDm-mi-001">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="orderFrontStandardAboutPanel:" target="-1" id="WDm-ac-002"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="WDm-sp-003"/>
                            <menuItem title="Hide WorkflowDesk" keyEquivalent="h" id="WDm-mi-004">
                                <connections>
                                    <action selector="hide:" target="-1" id="WDm-ac-005"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Hide Others" keyEquivalent="h" id="WDm-mi-006">
                                <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                                <connections>
                                    <action selector="hideOtherApplications:" target="-1" id="WDm-ac-007"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Show All" id="WDm-mi-008">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="unhideAllApplications:" target="-1" id="WDm-ac-009"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="WDm-sp-010"/>
                            <menuItem title="Quit WorkflowDesk" keyEquivalent="q" id="WDm-mi-011">
                                <connections>
                                    <action selector="terminate:" target="-1" id="WDm-ac-012"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="File" id="WDm-mt-022">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="File" id="WDm-mn-023">
                        <items>
                            <menuItem title="Connect to Server…" keyEquivalent="k" id="WDm-mi-015">
                                <connections>
                                    <action selector="connect:" target="WDm-de-001" id="WDm-ac-016"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Sign Out" id="WDm-mi-017">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="signOut:" target="WDm-de-001" id="WDm-ac-018"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="WDm-sp-019"/>
                            <menuItem title="Close" keyEquivalent="w" id="WDm-mi-020">
                                <connections>
                                    <action selector="performClose:" target="-1" id="WDm-ac-021"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Edit" id="WDm-mt-038">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Edit" id="WDm-mn-039">
                        <items>
                            <menuItem title="Undo" keyEquivalent="z" id="WDm-mi-024">
                                <connections>
                                    <action selector="undo:" target="-1" id="WDm-ac-025"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Redo" keyEquivalent="Z" id="WDm-mi-026">
                                <connections>
                                    <action selector="redo:" target="-1" id="WDm-ac-027"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="WDm-sp-028"/>
                            <menuItem title="Cut" keyEquivalent="x" id="WDm-mi-029">
                                <connections>
                                    <action selector="cut:" target="-1" id="WDm-ac-030"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Copy" keyEquivalent="c" id="WDm-mi-031">
                                <connections>
                                    <action selector="copy:" target="-1" id="WDm-ac-032"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Paste" keyEquivalent="v" id="WDm-mi-033">
                                <connections>
                                    <action selector="paste:" target="-1" id="WDm-ac-034"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="WDm-sp-035"/>
                            <menuItem title="Select All" keyEquivalent="a" id="WDm-mi-036">
                                <connections>
                                    <action selector="selectAll:" target="-1" id="WDm-ac-037"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="View" id="WDm-mt-042">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="View" id="WDm-mn-043">
                        <items>
                            <menuItem title="Refresh" keyEquivalent="r" id="WDm-mi-040">
                                <connections>
                                    <action selector="refresh:" target="-1" id="WDm-ac-041"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Window" id="WDm-mt-053">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Window" systemMenu="window" id="WDm-mn-054">
                        <items>
                            <menuItem title="Tasks" keyEquivalent="1" id="WDm-mi-044">
                                <connections>
                                    <action selector="showTasks:" target="WDm-de-001" id="WDm-ac-045"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Operations" keyEquivalent="2" id="WDm-mi-046">
                                <connections>
                                    <action selector="showOperations:" target="WDm-de-001" id="WDm-ac-047"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="WDm-sp-048"/>
                            <menuItem title="Minimize" keyEquivalent="m" id="WDm-mi-049">
                                <connections>
                                    <action selector="performMiniaturize:" target="-1" id="WDm-ac-050"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Bring All to Front" id="WDm-mi-051">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="arrangeInFront:" target="-1" id="WDm-ac-052"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
            </items>
        </menu>
    </objects>
</document>
