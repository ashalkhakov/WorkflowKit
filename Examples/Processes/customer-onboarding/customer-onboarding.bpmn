      <bpmndi:BPMNEdge id="toOnboarded_Edge" bpmnElement="toOnboarded">
        <di:waypoint x="997" y="267"/>
        <di:waypoint x="1092" y="267"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>