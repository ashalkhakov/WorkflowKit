<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="loan-application-definitions" targetNamespace="http://example.com/workflowkit">
  <bpmn:collaboration id="loan-collaboration">
    <bpmn:participant id="bank" name="Bank" processRef="loan-application"/>
  </bpmn:collaboration>
  <bpmn:process id="loan-application" name="Loan application" isExecutable="true" camunda:candidateStarterGroups="branch-staff">
    <bpmn:documentation>A loan application is scored by the decisions in risk.dmn: Loan risk, which requires the Applicant score (points for years employed, debts and credit history, added up), and the Loan limit, a literal expression. A low risk within the limit is paid out at once, a medium one goes to an underwriter -- a senior one for a large loan, routed by the workload listener -- and anything else is declined by mail.</bpmn:documentation>
    <bpmn:laneSet id="loan-application-lanes">
      <bpmn:lane id="loan-system" name="Loan system">
        <bpmn:flowNodeRef>applied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>limit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>byRisk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="underwriters" name="Underwriters">
        <bpmn:flowNodeRef>underwrite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>byUnderwriter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="payments" name="Payments">
        <bpmn:flowNodeRef>payable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>payOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refusable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>declined</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="applied" name="Application received">
      <bpmn:extensionElements>
        <camunda:formData businessKey="applicationId">
          <camunda:formField id="applicationId" label="Application" type="string">
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="applicant" label="Applicant" type="string">
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="amount" label="Amount" type="long">
            <camunda:validation>
              <camunda:constraint name="required"/>
              <camunda:constraint name="min" config="500"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="income" label="Yearly income" type="long">
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="debts" label="Other debts" type="long" defaultValue="0"/>
          <camunda:formField id="employedSince" label="Employed since" type="date">
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="hasDefaulted" label="Has defaulted before" type="boolean" defaultValue="false"/>
        </camunda:formData>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="assess" name="Assess risk" camunda:decisionRef="loan-risk" camunda:resultVariable="risk" camunda:mapDecisionResult="singleEntry"/>
    <bpmn:businessRuleTask id="limit" name="Work out limit" camunda:decisionRef="loan-limit" camunda:resultVariable="maxLoan" camunda:mapDecisionResult="singleEntry"/>
    <bpmn:exclusiveGateway id="byRisk" name="Risk?" default="highRisk"/>
    <bpmn:userTask id="underwrite" name="Underwrite loan" camunda:candidateGroups="underwriters" camunda:dueDate="=now() + duration(&quot;P2D&quot;)" camunda:formKey="embedded:deployment:underwrite.xhtml">
      <bpmn:extensionElements>
        <camunda:taskListener event="create" delegateExpression="${workload}">
          <camunda:field name="queue" stringValue="underwriting"/>
          <camunda:field name="assignTo" expression="=if amount &gt; 50000 then &quot;senior-underwriter&quot; else null"/>
        </camunda:taskListener>
        <camunda:inputOutput>
          <camunda:inputParameter name="summary">
            <camunda:map>
              <camunda:entry key="applicant">${applicant}</camunda:entry>
              <camunda:entry key="amount">${amount}</camunda:entry>
              <camunda:entry key="limit">${maxLoan}</camunda:entry>
              <camunda:entry key="share">=amount / income</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:formData>
          <camunda:formField id="applicant" label="Applicant" type="string">
            <camunda:validation>
              <camunda:constraint name="readonly"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="employedSince" label="Employed since" type="date">
            <camunda:validation>
              <camunda:constraint name="readonly"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="income" label="Yearly income" type="long">
            <camunda:validation>
              <camunda:constraint name="readonly"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="debts" label="Other debts" type="long">
            <camunda:validation>
              <camunda:constraint name="readonly"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="amount" label="Amount" type="long">
            <camunda:validation>
              <camunda:constraint name="readonly"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="risk" label="Risk" type="string">
            <camunda:validation>
              <camunda:constraint name="readonly"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="maxLoan" label="Limit" type="string">
            <camunda:validation>
              <camunda:constraint name="readonly"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="approved" label="Approve" type="boolean">
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="comment" label="Reason" type="string">
            <camunda:validation>
              <camunda:constraint name="maxlength" config="500"/>
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="byUnderwriter" name="Approved?" default="refusedFlow"/>
    <bpmn:exclusiveGateway id="payable"/>
    <bpmn:serviceTask id="payOut" name="Pay out" camunda:type="external" camunda:topic="pay-out">
      <bpmn:extensionElements>
        <camunda:executionListener event="end" delegateExpression="${audit}">
          <camunda:field name="note" expression="=&quot;paid &quot; + string(amount)"/>
        </camunda:executionListener>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="paid" name="Loan paid out"/>
    <bpmn:exclusiveGateway id="refusable"/>
    <bpmn:sendTask id="decline" name="Send decline letter" camunda:delegateExpression="${mailer}">
      <bpmn:extensionElements>
        <camunda:field name="to" expression="=applicant"/>
        <camunda:field name="template" stringValue="loan-declined"/>
        <camunda:field name="subject" expression="=&quot;Your application &quot; + applicationId"/>
      </bpmn:extensionElements>
    </bpmn:sendTask>
    <bpmn:endEvent id="declined" name="Declined"/>
    <bpmn:sequenceFlow id="toAssess" sourceRef="applied" targetRef="assess"/>
    <bpmn:sequenceFlow id="toLimit" sourceRef="assess" targetRef="limit"/>
    <bpmn:sequenceFlow id="toRisk" sourceRef="limit" targetRef="byRisk"/>
    <bpmn:sequenceFlow id="lowRisk" name="low" sourceRef="byRisk" targetRef="payable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">risk = "low" and amount &lt;= maxLoan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="mediumRisk" name="medium" sourceRef="byRisk" targetRef="underwrite">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${risk == 'medium'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="highRisk" name="high" sourceRef="byRisk" targetRef="refusable"/>
    <bpmn:sequenceFlow id="toDecide" sourceRef="underwrite" targetRef="byUnderwriter"/>
    <bpmn:sequenceFlow id="approvedFlow" name="yes" sourceRef="byUnderwriter" targetRef="payable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="refusedFlow" name="no" sourceRef="byUnderwriter" targetRef="refusable"/>
    <bpmn:sequenceFlow id="toPayOut" sourceRef="payable" targetRef="payOut"/>
    <bpmn:sequenceFlow id="toPaid" sourceRef="payOut" targetRef="paid"/>
    <bpmn:sequenceFlow id="toDecline" sourceRef="refusable" targetRef="decline"/>
    <bpmn:sequenceFlow id="toDeclined" sourceRef="decline" targetRef="declined"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_l83cvc8">
    <bpmndi:BPMNPlane xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" id="BPMNPlane_6goxkfm" bpmnElement="loan-collaboration">
      <bpmndi:BPMNShape id="applied_Shape" bpmnElement="applied">
        <dc:Bounds x="80" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="assess_Shape" bpmnElement="assess">
        <dc:Bounds x="186" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="byRisk_Shape" bpmnElement="byRisk">
        <dc:Bounds x="526" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="underwrite_Shape" bpmnElement="underwrite">
        <dc:Bounds x="646" y="257" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="byUnderwriter_Shape" bpmnElement="byUnderwriter">
        <dc:Bounds x="816" y="272" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="payable_Shape" bpmnElement="payable">
        <dc:Bounds x="936" y="449" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="payOut_Shape" bpmnElement="payOut">
        <dc:Bounds x="1056" y="434" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="paid_Shape" bpmnElement="paid">
        <dc:Bounds x="1226" y="456" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="refusable_Shape" bpmnElement="refusable">
        <dc:Bounds x="936" y="589" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decline_Shape" bpmnElement="decline">
        <dc:Bounds x="1056" y="574" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="declined_Shape" bpmnElement="declined">
        <dc:Bounds x="1226" y="596" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toAssess_Edge" bpmnElement="toAssess">
        <di:waypoint x="116" y="120"/>
        <di:waypoint x="186" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toRisk_Edge" bpmnElement="toRisk">
        <di:waypoint x="456" y="120"/>
        <di:waypoint x="526" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="lowRisk_Edge" bpmnElement="lowRisk">
        <di:waypoint x="551" y="145"/>
        <di:waypoint x="551" y="474"/>
        <di:waypoint x="936" y="474"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mediumRisk_Edge" bpmnElement="mediumRisk">
        <di:waypoint x="551" y="145"/>
        <di:waypoint x="551" y="297"/>
        <di:waypoint x="646" y="297"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="highRisk_Edge" bpmnElement="highRisk">
        <di:waypoint x="551" y="145"/>
        <di:waypoint x="551" y="614"/>
        <di:waypoint x="936" y="614"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDecide_Edge" bpmnElement="toDecide">
        <di:waypoint x="746" y="297"/>
        <di:waypoint x="816" y="297"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="approvedFlow_Edge" bpmnElement="approvedFlow">
        <di:waypoint x="841" y="322"/>
        <di:waypoint x="841" y="474"/>
        <di:waypoint x="936" y="474"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="refusedFlow_Edge" bpmnElement="refusedFlow">
        <di:waypoint x="841" y="322"/>
        <di:waypoint x="841" y="614"/>
        <di:waypoint x="936" y="614"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toPayOut_Edge" bpmnElement="toPayOut">
        <di:waypoint x="986" y="474"/>
        <di:waypoint x="1056" y="474"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toPaid_Edge" bpmnElement="toPaid">
        <di:waypoint x="1156" y="474"/>
        <di:waypoint x="1226" y="474"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDecline_Edge" bpmnElement="toDecline">
        <di:waypoint x="986" y="614"/>
        <di:waypoint x="1056" y="614"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDeclined_Edge" bpmnElement="toDeclined">
        <di:waypoint x="1156" y="614"/>
        <di:waypoint x="1226" y="614"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="limit_Shape" bpmnElement="limit">
        <dc:Bounds x="356" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toLimit_Edge" bpmnElement="toLimit">
        <di:waypoint x="286" y="120"/>
        <di:waypoint x="356" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="payments_Shape" bpmnElement="payments" isHorizontal="true">
        <dc:Bounds x="10" y="394" width="1292" height="317"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="underwriters_Shape" bpmnElement="underwriters" isHorizontal="true">
        <dc:Bounds x="10" y="217" width="1292" height="177"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="loan-system_Shape" bpmnElement="loan-system" isHorizontal="true">
        <dc:Bounds x="10" y="40" width="1292" height="177"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bank_Shape" bpmnElement="bank" isHorizontal="true">
        <dc:Bounds x="-20" y="40" width="1322" height="671"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>