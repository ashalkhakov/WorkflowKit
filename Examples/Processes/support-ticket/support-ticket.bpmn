      <bpmndi:BPMNShape id="toEngineering_Shape" bpmnElement="toEngineering">
        <dc:Bounds x="471" y="292" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toDiagnose_Edge" bpmnElement="toDiagnose">
        <di:waypoint x="262" y="213"/>
        <di:waypoint x="332" y="213"/>
      </bpmndi:BPMNEdge>
