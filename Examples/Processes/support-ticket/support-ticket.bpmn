<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="support-ticket-definitions" targetNamespace="http://example.com/workflowkit">
  <bpmn:message id="customerReplied" name="customer-replied"/>
  <bpmn:message id="ticketWithdrawn" name="ticket-withdrawn"/>
  <bpmn:escalation id="needsEngineering" name="Needs engineering" escalationCode="engineering"/>
  <bpmn:process id="support-ticket" name="Support ticket" isExecutable="true">
    <bpmn:documentation>Support resolves a ticket within eight hours, or a supervisor takes it over. A ticket that needs a product fix is escalated: engineering is told while support goes on. The customer may write in at any time, and may withdraw the ticket, which ends everything. The workload listener gives the diagnosis an urgent ticket an hour, any other four; the audit listener records when resolving starts and ends.</bpmn:documentation>
    <bpmn:startEvent id="opened" name="Ticket opened"/>
    <bpmn:subProcess id="resolve" name="Resolve ticket">
      <bpmn:extensionElements>
        <camunda:executionListener event="start" delegateExpression="${audit}"/>
        <camunda:executionListener event="end" delegateExpression="${audit}"/>
      </bpmn:extensionElements>
      <bpmn:startEvent id="resolveStart"/>
      <bpmn:userTask id="diagnose" name="Diagnose" camunda:candidateGroups="support">
        <bpmn:extensionElements>
          <camunda:taskListener event="create" delegateExpression="${workload}">
            <camunda:field name="queue" stringValue="support"/>
            <camunda:field name="dueIn" expression="=if priority = &quot;urgent&quot; then &quot;PT1H&quot; else &quot;PT4H&quot;"/>
          </camunda:taskListener>
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="productBug" name="Product bug?" default="noBugFlow"/>
      <bpmn:intermediateThrowEvent id="escalate" name="Needs engineering">
        <bpmn:escalationEventDefinition escalationRef="needsEngineering"/>
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="workaround" name="Give workaround" camunda:candidateGroups="support"/>
      <bpmn:exclusiveGateway id="answered"/>
      <bpmn:endEvent id="resolveEnd"/>
      <bpmn:sequenceFlow id="toDiagnose" sourceRef="resolveStart" targetRef="diagnose"/>
      <bpmn:sequenceFlow id="toBug" sourceRef="diagnose" targetRef="productBug"/>
      <bpmn:sequenceFlow id="bugFlow" name="yes" sourceRef="productBug" targetRef="escalate">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">bug = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="toWorkaround" sourceRef="escalate" targetRef="workaround"/>
      <bpmn:sequenceFlow id="noBugFlow" name="no" sourceRef="productBug" targetRef="answered"/>
      <bpmn:sequenceFlow id="workedAround" sourceRef="workaround" targetRef="answered"/>
      <bpmn:sequenceFlow id="toResolveEnd" sourceRef="answered" targetRef="resolveEnd"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="sla" name="8 hours" attachedToRef="resolve">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT8H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="takeOver" name="Take over ticket" camunda:candidateGroups="supervisors"/>
    <bpmn:boundaryEvent id="toEngineering" name="Needs engineering" attachedToRef="resolve" cancelActivity="false">
      <bpmn:escalationEventDefinition escalationRef="needsEngineering"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="fileBug" name="File bug report" camunda:type="external" camunda:topic="file-bug"/>
    <bpmn:endEvent id="filed" name="Bug filed"/>
    <bpmn:exclusiveGateway id="closing"/>
    <bpmn:endEvent id="closed" name="Ticket closed"/>
    <bpmn:subProcess id="onReply" name="Customer replied" triggeredByEvent="true">
      <bpmn:startEvent id="replied" name="Reply received" isInterrupting="false">
        <bpmn:messageEventDefinition messageRef="customerReplied"/>
      </bpmn:startEvent>
      <bpmn:userTask id="readReply" name="Read reply" camunda:candidateGroups="support"/>
      <bpmn:endEvent id="read"/>
      <bpmn:sequenceFlow id="toRead" sourceRef="replied" targetRef="readReply"/>
      <bpmn:sequenceFlow id="toReadEnd" sourceRef="readReply" targetRef="read"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="onWithdraw" name="Ticket withdrawn" triggeredByEvent="true">
      <bpmn:startEvent id="withdrawn" name="Withdrawn">
        <bpmn:messageEventDefinition messageRef="ticketWithdrawn"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="cancelled" name="Cancelled">
        <bpmn:terminateEventDefinition/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="toCancelled" sourceRef="withdrawn" targetRef="cancelled"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="toResolve" sourceRef="opened" targetRef="resolve"/>
    <bpmn:sequenceFlow id="resolved" sourceRef="resolve" targetRef="closing"/>
    <bpmn:sequenceFlow id="toTakeOver" sourceRef="sla" targetRef="takeOver"/>
    <bpmn:sequenceFlow id="takenOver" sourceRef="takeOver" targetRef="closing"/>
    <bpmn:sequenceFlow id="toFileBug" sourceRef="toEngineering" targetRef="fileBug"/>
    <bpmn:sequenceFlow id="toFiled" sourceRef="fileBug" targetRef="filed"/>
    <bpmn:sequenceFlow id="toClosed" sourceRef="closing" targetRef="closed"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1ecc6tk">
    <bpmndi:BPMNPlane xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" id="BPMNPlane_pdvr2ly" bpmnElement="support-ticket">
      <bpmndi:BPMNShape id="opened_Shape" bpmnElement="opened">
        <dc:Bounds x="80" y="177" width="36" height="36"/>
      </bpmndi:BPMNShape>
