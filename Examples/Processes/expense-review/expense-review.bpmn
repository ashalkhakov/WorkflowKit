<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="expense-review-definitions" targetNamespace="http://example.com/workflowkit">
  <bpmn:collaboration id="expense-collaboration">
    <bpmn:participant id="company" name="Company" processRef="expense-review"/>
  </bpmn:collaboration>
  <bpmn:process id="expense-review" name="Expense review" isExecutable="true">
    <bpmn:documentation>An expense claim -- lines, each an item and an amount -- has its receipts checked by finance first when any line is over 500. It then goes to every reviewer named in it at once, with the total and the largest line worked out for them; each reviews it on the review form, which shows the lines and asks for a reason to reject; two approvals are enough, and the reviews still open are withdrawn then. Each reviewer is mailed the outcome in turn, one after another.</bpmn:documentation>
    <bpmn:laneSet id="expense-review-lanes">
      <bpmn:lane id="employee" name="Employee">
        <bpmn:flowNodeRef>claimed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="finance" name="Finance">
        <bpmn:flowNodeRef>receiptsNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>checkReceipts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receiptsDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reimburse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="reviewers" name="Reviewers">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approvedEnough</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="claimed" name="Expense claimed"/>
    <bpmn:exclusiveGateway id="receiptsNeeded" name="Any line over 500?" default="noReceiptsFlow"/>
    <bpmn:userTask id="checkReceipts" name="Check receipts" camunda:candidateGroups="finance"/>
    <bpmn:exclusiveGateway id="receiptsDone"/>
    <bpmn:userTask id="review" name="Review claim" camunda:assignee="${reviewer}" camunda:formKey="embedded:deployment:review.xhtml" camunda:formHandlerClass="expenseReview">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="total">=sum(lines.amount)</camunda:inputParameter>
          <camunda:inputParameter name="largest">=max(lines.amount)</camunda:inputParameter>
          <camunda:outputParameter name="approvals">=approvals + (if approved then 1 else 0)</camunda:outputParameter>
          <camunda:outputParameter name="notes">=notes</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="reviewers" camunda:elementVariable="reviewer">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">approvals &gt;= 2</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="approvedEnough" name="Two approvals?" default="rejectedFlow"/>
    <bpmn:serviceTask id="reimburse" name="Reimburse" camunda:type="external" camunda:topic="reimburse"/>
    <bpmn:exclusiveGateway id="decided"/>
    <bpmn:sendTask id="notify" name="Tell reviewer" camunda:delegateExpression="${mailer}">
      <bpmn:extensionElements>
        <camunda:field name="to" expression="=reviewer"/>
        <camunda:field name="template" stringValue="claim-settled"/>
        <camunda:field name="subject" expression="=if approvals &gt;= 2 then &quot;Claim approved&quot; else &quot;Claim rejected&quot;"/>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="reviewers" camunda:elementVariable="reviewer"/>
    </bpmn:sendTask>
    <bpmn:endEvent id="done" name="Claim settled"/>
    <bpmn:sequenceFlow id="toReceipts" sourceRef="claimed" targetRef="receiptsNeeded"/>
    <bpmn:sequenceFlow id="receiptsFlow" name="yes" sourceRef="receiptsNeeded" targetRef="checkReceipts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">some line in lines satisfies line.amount &gt; 500</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="noReceiptsFlow" name="no" sourceRef="receiptsNeeded" targetRef="receiptsDone"/>
    <bpmn:sequenceFlow id="receiptsChecked" sourceRef="checkReceipts" targetRef="receiptsDone"/>
    <bpmn:sequenceFlow id="toReview" sourceRef="receiptsDone" targetRef="review"/>
    <bpmn:sequenceFlow id="toDecision" sourceRef="review" targetRef="approvedEnough"/>
    <bpmn:sequenceFlow id="approvedFlow" name="yes" sourceRef="approvedEnough" targetRef="reimburse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approvals &gt;= 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="rejectedFlow" name="no" sourceRef="approvedEnough" targetRef="decided"/>
    <bpmn:sequenceFlow id="reimbursed" sourceRef="reimburse" targetRef="decided"/>
    <bpmn:sequenceFlow id="toNotify" sourceRef="decided" targetRef="notify"/>
    <bpmn:sequenceFlow id="toDone" sourceRef="notify" targetRef="done"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_tb1f54i">
    <bpmndi:BPMNPlane xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" id="BPMNPlane_1bt2liv" bpmnElement="expense-collaboration">
      <bpmndi:BPMNShape id="claimed_Shape" bpmnElement="claimed">
        <dc:Bounds x="80" y="80" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_Shape" bpmnElement="review">
        <dc:Bounds x="596" y="473" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approvedEnough_Shape" bpmnElement="approvedEnough">
        <dc:Bounds x="766" y="488" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reimburse_Shape" bpmnElement="reimburse">
        <dc:Bounds x="886" y="236" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decided_Shape" bpmnElement="decided">
        <dc:Bounds x="1056" y="311" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify_Shape" bpmnElement="notify">
        <dc:Bounds x="1176" y="296" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="done_Shape" bpmnElement="done">
        <dc:Bounds x="1346" y="318" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toReview_Edge" bpmnElement="toReview">
        <di:waypoint x="501" y="353"/>
        <di:waypoint x="501" y="513"/>
        <di:waypoint x="596" y="513"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDecision_Edge" bpmnElement="toDecision">
        <di:waypoint x="696" y="513"/>
        <di:waypoint x="766" y="513"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="approvedFlow_Edge" bpmnElement="approvedFlow">
        <di:waypoint x="791" y="488"/>
        <di:waypoint x="791" y="276"/>
        <di:waypoint x="886" y="276"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="rejectedFlow_Edge" bpmnElement="rejectedFlow">
        <di:waypoint x="791" y="488"/>
        <di:waypoint x="791" y="336"/>
        <di:waypoint x="1056" y="336"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="reimbursed_Edge" bpmnElement="reimbursed">
        <di:waypoint x="986" y="276"/>
        <di:waypoint x="1081" y="276"/>
        <di:waypoint x="1081" y="311"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toNotify_Edge" bpmnElement="toNotify">
        <di:waypoint x="1106" y="336"/>
        <di:waypoint x="1176" y="336"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDone_Edge" bpmnElement="toDone">
        <di:waypoint x="1276" y="336"/>
        <di:waypoint x="1346" y="336"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="receiptsNeeded_Shape" bpmnElement="receiptsNeeded">
        <dc:Bounds x="186" y="296" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="checkReceipts_Shape" bpmnElement="checkReceipts">
        <dc:Bounds x="306" y="228" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="receiptsDone_Shape" bpmnElement="receiptsDone">
        <dc:Bounds x="476" y="303" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toReceipts_Edge" bpmnElement="toReceipts">
        <di:waypoint x="116" y="98"/>
        <di:waypoint x="211" y="98"/>
        <di:waypoint x="211" y="296"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="receiptsFlow_Edge" bpmnElement="receiptsFlow">
        <di:waypoint x="211" y="296"/>
        <di:waypoint x="211" y="268"/>
        <di:waypoint x="306" y="268"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="noReceiptsFlow_Edge" bpmnElement="noReceiptsFlow">
        <di:waypoint x="211" y="346"/>
        <di:waypoint x="211" y="328"/>
        <di:waypoint x="476" y="328"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="receiptsChecked_Edge" bpmnElement="receiptsChecked">
        <di:waypoint x="406" y="268"/>
        <di:waypoint x="501" y="268"/>
        <di:waypoint x="501" y="303"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="reviewers_Shape" bpmnElement="reviewers" isHorizontal="true">
        <dc:Bounds x="10" y="433" width="1412" height="177"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finance_Shape" bpmnElement="finance" isHorizontal="true">
        <dc:Bounds x="10" y="188" width="1412" height="245"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="employee_Shape" bpmnElement="employee" isHorizontal="true">
        <dc:Bounds x="10" y="40" width="1412" height="148"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="company_Shape" bpmnElement="company" isHorizontal="true">
        <dc:Bounds x="-20" y="40" width="1442" height="570"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>