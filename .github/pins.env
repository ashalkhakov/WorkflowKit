# What WorkflowKit builds on, by the exact versions of their releases:
# gnustep-release-actions' workflows (scripts/deps.sh) fetch them from here.
# To move one, edit it here.
#   Linux    each one's archive, unpacked into /opt/gnustep, the stack first
#   Windows  each one's archive, unpacked into C:\GNUstep, the stack first

# The patched GNUstep stack (ashalkhakov/gnustep-patches), with Opal and
# corebase, which XFormsKit's form view draws through.
GNUSTEP_PATCHES_VERSION=2026.10.20.48
# Core Data on GNUstep, with momc (ashalkhakov/FreeCoreData), the engine's
# store; and its PostgreSQL and MySQL stores, which wf-serve and the tests
# use, archives of their own.
FREECOREDATA_VERSION=0.11.0
FREECOREDATA_PARTS="postgresql mysql"
# HTTPServerKit's listener, which ODataKit's libraries link on GNUstep
# (ashalkhakov/GCDWebServer).
GCDWEBSERVER_VERSION=3.5.4.2
# The OData API (WorkflowKitOData), wf-serve's server and the apps' client
# (ashalkhakov/ODataKit).
ODATAKIT_VERSION=0.4.3
# The process diagrams' layout, drawing and canvas (ashalkhakov/DiagramKit).
DIAGRAMKIT_VERSION=0.2.1
# WorkflowDesk's forms (XFormsKit) and the designer's form editor
# (XFormsDesignKit) (ashalkhakov/XFormsKit).
XFORMSKIT_VERSION=0.2.2
# UDCode's SDK (ashalkhakov/UDCodeKit): what the BPMN and DMN extension
# (UDCodeExtension/) is built against, and the UDCode it is packaged with.
UDCODEKIT_VERSION=0.22.2
# Sparkle, the apps' updates on macOS (scripts/deps.sh apple, into .deps/;
# the Xcode project links it).
SPARKLE_VERSION=2.10.0
