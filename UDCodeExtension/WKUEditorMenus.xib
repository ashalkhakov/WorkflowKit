                </menuItem>
                <menuItem isSeparatorItem="YES" id="wkmn-sp-050" />
                <menuItem title="Add Rule" id="wkmn-mi-051">
                    <connections>
                        <action selector="addRule:" target="-1" id="wkmn-ac-052" />
                    </connections>
                </menuItem>
                <menuItem title="Move Rule Up" id="wkmn-mi-053">
                    <connections>
                        <action selector="moveRuleUp:" target="-1" id="wkmn-ac-054" />
