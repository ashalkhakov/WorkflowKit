                </menuItem>
                <menuItem title="Actual Size" id="wkmn-mi-039">
                    <connections>
                        <action selector="actualSize:" target="-1" id="wkmn-ac-040" />
                    </connections>
                </menuItem>
                <menuItem title="Zoom to Fit" id="wkmn-mi-041">
                    <connections>
                        <action selector="zoomToFit:" target="-1" id="wkmn-ac-042" />
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="wkmn-sp-043" />
                <menuItem title="Add Decision Table" id="wkmn-mi-044">
                    <connections>
                        <action selector="addDecisionTable:" target="-1" id="wkmn-ac-045" />
