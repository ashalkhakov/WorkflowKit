                </menuItem>
                <menuItem isSeparatorItem="YES" id="wkmn-sp-057" />
                <menuItem title="Add Input" id="wkmn-mi-058">
                    <connections>
                        <action selector="addInput:" target="-1" id="wkmn-ac-059" />
