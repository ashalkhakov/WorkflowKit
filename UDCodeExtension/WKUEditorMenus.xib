<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23504" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23504" />
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSObject" />
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder" />
        <customObject id="-3" userLabel="Application" customClass="NSObject" />
        <!-- The Editor menu's items (WKUExtension's -editorMenuItemsForWorkbench:): to the
             first responder, which in a process's tab is its commands and its canvas,
             and in a DMN file's its list and its grid -->
        <menu title="BPMN and DMN" id="wkmn-root">
            <items>
                <menuItem title="Arrange" id="wkmn-mi-001">
                    <connections>
                        <action selector="arrange:" target="-1" id="wkmn-ac-002" />
                    </connections>
                </menuItem>
                <menuItem title="Add Pool" id="wkmn-mi-003">
                    <connections>
                        <action selector="addPool:" target="-1" id="wkmn-ac-004" />
                    </connections>
                </menuItem>
                <menuItem title="Add Lane" id="wkmn-mi-005">
                    <connections>
                        <action selector="addLane:" target="-1" id="wkmn-ac-006" />
                    </connections>
                </menuItem>
                <menuItem title="Rename" id="wkmn-mi-007">
                    <connections>
                        <action selector="rename:" target="-1" id="wkmn-ac-008" />
                    </connections>
                </menuItem>
                <menuItem title="Align" id="wkmn-mi-009">
                    <menu key="submenu" title="Align" id="wkmn-mn-010">
                        <items>
                            <menuItem title="Left Edges" id="wkmn-mi-011">
                                <connections>
                                    <action selector="alignLeftEdges:" target="-1" id="wkmn-ac-012" />
                                </connections>
                            </menuItem>
                            <menuItem title="Centres" id="wkmn-mi-013">
                                <connections>
                                    <action selector="alignCentres:" target="-1" id="wkmn-ac-014" />
                                </connections>
                            </menuItem>
                            <menuItem title="Right Edges" id="wkmn-mi-015">
                                <connections>
                                    <action selector="alignRightEdges:" target="-1" id="wkmn-ac-016" />
                                </connections>
                            </menuItem>
                            <menuItem title="Top Edges" id="wkmn-mi-017">
                                <connections>
                                    <action selector="alignTopEdges:" target="-1" id="wkmn-ac-018" />
                                </connections>
                            </menuItem>
                            <menuItem title="Middles" id="wkmn-mi-019">
                                <connections>
                                    <action selector="alignMiddles:" target="-1" id="wkmn-ac-020" />
                                </connections>
                            </menuItem>
                            <menuItem title="Bottom Edges" id="wkmn-mi-021">
                                <connections>
                                    <action selector="alignBottomEdges:" target="-1" id="wkmn-ac-022" />
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Distribute" id="wkmn-mi-023">
                    <menu key="submenu" title="Distribute" id="wkmn-mn-024">
                        <items>
                            <menuItem title="Across" id="wkmn-mi-025">
                                <connections>
                                    <action selector="distributeAcross:" target="-1" id="wkmn-ac-026" />
                                </connections>
                            </menuItem>
                            <menuItem title="Down" id="wkmn-mi-027">
                                <connections>
                                    <action selector="distributeDown:" target="-1" id="wkmn-ac-028" />
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="wkmn-sp-029" />
                <menuItem title="Edit Form…" id="wkmn-mi-030">
                    <connections>
                        <action selector="editForm:" target="-1" id="wkmn-ac-031" />
                    </connections>
                </menuItem>
                <menuItem title="Edit Decision…" id="wkmn-mi-032">
                    <connections>
                        <action selector="editDecision:" target="-1" id="wkmn-ac-033" />
