                </menuItem>
                <menuItem title="Move Column Left" id="wkmn-mi-064">
                    <connections>
                        <action selector="moveColumnLeft:" target="-1" id="wkmn-ac-065" />
                    </connections>
                </menuItem>
                <menuItem title="Move Column Right" id="wkmn-mi-066">
                    <connections>
                        <action selector="moveColumnRight:" target="-1" id="wkmn-ac-067" />
