                </menuItem>
                <menuItem isSeparatorItem="YES" id="wkmn-sp-034" />
                <menuItem title="Zoom In" id="wkmn-mi-035">
                    <connections>
                        <action selector="zoomIn:" target="-1" id="wkmn-ac-036" />
                    </connections>
                </menuItem>
                <menuItem title="Zoom Out" id="wkmn-mi-037">
                    <connections>
                        <action selector="zoomOut:" target="-1" id="wkmn-ac-038" />
