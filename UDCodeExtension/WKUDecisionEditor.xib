<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23504" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23504" />
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="WKUDecisionEditorViewController">
            <connections>
                <outlet property="view" destination="wkud-vw-000" id="wkud-co-001" />
                <outlet property="editorView" destination="wkud-ev-000" id="wkud-co-002" />
                <outlet property="split" destination="wkud-sp-000" id="wkud-co-003" />
                <outlet property="listHost" destination="wkud-hs-001" id="wkud-co-004" />
                <outlet property="detailHost" destination="wkud-hs-003" id="wkud-co-009" />
                <outlet property="gridHost" destination="wkud-hs-004" id="wkud-co-010" />
                <outlet property="literalHost" destination="wkud-hs-005" id="wkud-co-011" />
                <outlet property="statusField" destination="wkud-st-000" id="wkud-co-006" />
                <outlet property="problemView" destination="wkud-pv-000" id="wkud-co-007" />
                <outlet property="problemLabel" destination="wkud-pl-000" id="wkud-co-008" />
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder" />
        <customObject id="-3" userLabel="Application" customClass="NSObject" />
        <!-- A DMN file's tab: the decisions listed; the one chosen, its detail over its table or its literal expression; the status under them (WKUDecisionEditorViewController) -->
        <customView id="wkud-vw-000" customClass="WKUEditorView">
            <rect key="frame" x="0.0" y="0.0" width="900" height="600" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
            <subviews>
                <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="wkud-ev-000" userLabel="editorView">
                    <rect key="frame" x="0.0" y="0.0" width="900" height="600" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                    <subviews>
                        <splitView fixedFrame="YES" arrangesAllSubviews="NO" dividerStyle="thin" vertical="YES" translatesAutoresizingMaskIntoConstraints="NO" id="wkud-sp-000">
                            <rect key="frame" x="0.0" y="22" width="900" height="578" />
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                            <subviews>
                                <customView fixedFrame="YES" id="wkud-hs-001" userLabel="listHost">
                                    <rect key="frame" x="0.0" y="0.0" width="220" height="578" />
                                    <autoresizingMask key="autoresizingMask" heightSizable="YES" />
                                </customView>
                                <customView fixedFrame="YES" id="wkud-hs-002" userLabel="decisionPane">
                                    <rect key="frame" x="221" y="0.0" width="679" height="578" />
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                                    <subviews>
                                        <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="wkud-hs-003" userLabel="detailHost">
                                            <rect key="frame" x="0.0" y="506" width="679" height="72" />
                                            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
                                        </customView>
                                        <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="wkud-hs-004" userLabel="gridHost">
                                            <rect key="frame" x="0.0" y="0.0" width="679" height="502" />
                                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                                        </customView>
                                        <customView hidden="YES" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="wkud-hs-005" userLabel="literalHost">
                                            <rect key="frame" x="0.0" y="0.0" width="679" height="502" />
                                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                                        </customView>
                                    </subviews>
                                </customView>
                            </subviews>
                            <holdingPriorities>
                                <real value="260" />
                                <real value="250" />
                            </holdingPriorities>
                            <connections>
                                <outlet property="delegate" destination="-2" id="wkud-sp-001" />
                            </connections>
                        </splitView>
                        <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="wkud-st-000" userLabel="statusField">
                            <rect key="frame" x="8" y="3" width="884" height="16" />
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES" />
                            <textFieldCell key="cell" lineBreakMode="truncatingTail" selectable="YES" title="" id="wkud-st-001">
                                <font key="font" metaFont="smallSystem" />
                                <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog" />
                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
                            </textFieldCell>
                        </textField>
                    </subviews>
                </customView>
                <customView hidden="YES" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="wkud-pv-000" userLabel="problemView">
                    <rect key="frame" x="0.0" y="0.0" width="900" height="600" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                    <subviews>
                        <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="wkud-pl-000">
                            <rect key="frame" x="40" y="320" width="820" height="60" />
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" flexibleMaxY="YES" />
                            <textFieldCell key="cell" lineBreakMode="charWrapping" selectable="YES" alignment="center" title="" id="wkud-pl-001">
                                <font key="font" metaFont="system" />
                                <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog" />
                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
                            </textFieldCell>
                        </textField>
                        <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="wkud-pb-000">
                            <rect key="frame" x="385" y="270" width="130" height="32" />
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxX="YES" flexibleMinY="YES" flexibleMaxY="YES" />
                            <buttonCell key="cell" type="push" title="Show as Text" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="wkud-pb-001">
                                <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES" />
                                <font key="font" metaFont="system" />
                            </buttonCell>
                            <connections>
                                <action selector="showAsText:" target="-2" id="wkud-pb-002" />
                            </connections>
                        </button>
                    </subviews>
                </customView>
            </subviews>
            <connections>
                <outlet property="controller" destination="-2" id="wkud-vw-001" />
            </connections>
        </customView>
    </objects>
</document>
